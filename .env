# 网站标题
VITE_APP_TITLE = Cover-Wave

# 网站的ICP备案号码，footer 中展示备案信息
VITE_APP_ICP_NUMBER = 蜀ICP备2025137675号-2

# 网站的公安备案号码，footer 中展示备案信息
VITE_APP_POLICE_NUMBER = 川公网安备51010802001401号

# 公安备案图标路径，footer 中展示备案图标
# 请将图标文件放在public目录下，或填写完整URL
VITE_APP_POLICE_ICON_PATH = /tb.png

# 图床配置
# 上传API地址
VITE_APP_UPLOAD_API_URL = https://8.955991.xyz/upload
# 图片展示域名
VITE_APP_IMAGE_DOMAIN = https://8.955991.xyz
# 上传Token（本地开发时请在.env.local中配置真实值）
VITE_APP_UPLOAD_TOKEN = 

# 设置全局字体 （可选） 不填写则默认 如果是外部字体，则需要引入网络字体链接
VITE_APP_FONT_FAMILY = LXGW Bright Medium

# 引入网络字体链接 （可选） 不填写则不引入
VITE_APP_FONT_CSS_URL = https://oss-cdn.bsgun.cn/fonts/LXGW-Bright-Medium/font.css